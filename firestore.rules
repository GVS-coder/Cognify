rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Function to check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Function to check if the user is accessing their own data
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Protect user-scoped collections
    match /users/{userId} {
      // Allow read/write to the user document itself
      allow read, write: if isOwner(userId);
      
      // Allow read/write to all subcollections within the user document
      match /{document=**} {
        allow read, write: if isOwner(userId);
      }
    }
    
    // Deny access to everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
