    <string name="ui_by_default_all_your_data_is_st">By default, all your data is stored locally on your device for privacy. If you choose to enable cloud sync, it is securely backed up to Firebase Firestore.</string>
    
    <string name="ui_faq_cognify_overview">What is Cognify?</string>
    <string name="ui_faq_cognify_overview_desc">Cognify is a productivity application that integrates task management, knowledge tracking, AI assistance, and document analysis.</string>
    <string name="ui_faq_tasks_notes">How do I manage tasks and notes?</string>
    <string name="ui_faq_tasks_notes_desc">You can create, edit, and organize tasks and notes from the Dashboard. You can also set reminders for them.</string>
    <string name="ui_faq_smart_inbox">How does Smart Inbox work?</string>
    <string name="ui_faq_smart_inbox_desc">Smart Inbox securely reads your Gmail to find opportunities. Email content may be sent to our backend and third-party AI services for analysis. Data is not used for advertising.</string>
    <string name="ui_faq_account_login">How does my account work?</string>
    <string name="ui_faq_account_login_desc">You can use Cognify as a guest or sign in with Google/Email to sync your data across devices securely.</string>
    <string name="ui_faq_settings">How do I change Settings?</string>
    <string name="ui_faq_settings_desc">Navigate to the Settings tab to change your theme, language, AI preferences, and notification settings.</string>
