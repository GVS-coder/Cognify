<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/spacing_lg"
    app:cardBackgroundColor="?attr/colorSurface"
    
    >

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_lg">

        <!-- Dialog Title -->
        <TextView
            android:id="@+id/tvDialogTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/title_forgot_password"
            android:textColor="?attr/colorOnSurface"
            android:textSize="@dimen/text_xl"
            android:textStyle="bold"
            android:layout_marginBottom="@dimen/spacing_xs" />

        <!-- Dialog Subtitle -->
        <TextView
            android:id="@+id/tvDialogSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/subtitle_forgot_password"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="@dimen/text_body"
            android:lineSpacingExtra="3dp"
            android:layout_marginBottom="@dimen/spacing_lg" />

        <!-- Email Input -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilResetEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/label_email"
            style="@style/Widget.Cognify.TextInputLayout"
            app:startIconDrawable="@android:drawable/ic_dialog_email"
            app:startIconTint="@color/color_text_secondary">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etResetEmail"
                android:layout_width="match_parent"
                android:layout_height="@dimen/input_height"
                android:inputType="textEmailAddress"
                android:textColor="@color/color_input_text"
                android:imeOptions="actionDone"
                android:maxLines="1"
                android:hint="@string/hint_reset_email" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Error Text -->
        <TextView
            android:id="@+id/tvResetError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="@color/color_error_light"
            android:textSize="@dimen/text_sm"
            android:layout_marginTop="@dimen/spacing_xs"
            android:visibility="gone" />

        <!-- Progress Bar -->
        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:layout_marginTop="@dimen/spacing_sm"
            android:indeterminateTint="@color/color_primary"
            android:visibility="gone" />

        <!-- Buttons Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="@dimen/spacing_lg">

            <!-- Cancel Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancel"
                android:layout_width="0dp"
                android:layout_height="@dimen/button_height"
                android:layout_weight="1"
                android:text="@string/btn_cancel"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:backgroundTint="@color/color_surface"
                android:layout_marginEnd="@dimen/spacing_sm" />

            <!-- Send Reset Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSendReset"
                android:layout_width="0dp"
                android:layout_height="@dimen/button_height"
                android:layout_weight="1"
                android:text="@string/btn_send_reset"
                android:textColor="?attr/colorOnPrimary"
                android:background="@drawable/bg_button_primary"
                android:stateListAnimator="@null"
                android:layout_marginStart="@dimen/spacing_sm" />

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>

