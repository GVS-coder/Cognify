<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="176dp"
    android:background="?attr/colorSurface"
    android:gravity="bottom"
    android:orientation="vertical"
    android:padding="@dimen/spacing_lg">

    <ImageView
        android:id="@+id/ivNavProfile"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:src="@drawable/ic_person"
        android:contentDescription="Profile Header" />

    <TextView
        android:id="@+id/tvNavHeaderName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_sm"
        android:text="@string/ui_cognify_user"
        android:textColor="?attr/colorOnSurface"
        android:textSize="@dimen/text_lg"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvNavHeaderEmail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ui_user_cognify_app"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="@dimen/text_sm" />

</LinearLayout>

